rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────
    function isAuth() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }
    function getRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    function isAdmin() {
      return isAuth() && getRole() == 'admin';
    }
    function isSeller() {
      return isAuth() && (getRole() == 'seller' || getRole() == 'admin');
    }
    function isMotoboy() {
      return isAuth() && (getRole() == 'motoboy' || getRole() == 'admin');
    }

    // Campos que o próprio usuário NÃO pode alterar no perfil.
    function ownerProfileUpdateOk() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return !changed.hasAny(['role', 'uid', 'commissionRate', 'blockedUntil', 'birthDate',
                              'lastBirthdayBonusPeriod', 'createdAt'])
        && (!changed.hasAny(['loyaltyPoints'])
            || request.resource.data.loyaltyPoints <= resource.data.get('loyaltyPoints', 0))
        && (!changed.hasAny(['referralCode']) || resource.data.get('referralCode', '') in ['', null])
        && (!changed.hasAny(['referredBy']) || resource.data.get('referredBy', null) == null);
    }

    // ── Users ─────────────────────────────────────────────────
    match /users/{uid} {
      // Dono e admin sempre; vendedor também lê (PDV: busca de cliente p/ vincular
      // à venda presencial e atribuição de venda a um vendedor).
      allow read: if isOwner(uid) || isAdmin() || isSeller();
      // O próprio dono cria seu perfil; além disso, admin/vendedor podem cadastrar
      // um CLIENTE de balcão (walk-in) direto do PDV — restrito a role 'customer'
      // para não permitir a criação de contas de equipe/admin por aqui.
      // Auto-cadastro: só como 'customer' (o bootstrap do admin exige o e-mail do
      // admin no token), sem comissão e com no máximo o bônus de boas-vindas —
      // antes o próprio usuário podia nascer com role 'admin' ou pontos à vontade.
      // (50 = WELCOME_BONUS_POINTS em src/lib/loyalty/levels.ts; mantenha em sincronia.)
      allow create: if (isOwner(uid)
                        && request.resource.data.get('uid', uid) == uid
                        && (request.resource.data.get('role', 'customer') == 'customer'
                            || (request.resource.data.role == 'admin'
                                && request.auth.token.email == 'admin@shark.com'))
                        && !('commissionRate' in request.resource.data)
                        && request.resource.data.get('loyaltyPoints', 0) is number
                        && request.resource.data.get('loyaltyPoints', 0) <= 50)
                    || ((isAdmin() || isSeller()) && request.resource.data.role == 'customer');
      // Owner: atualiza o próprio perfil (menos o campo role). Inclui o débito
      // dos próprios pontos no resgate.
      // Admin: tudo.
      // A bonificação de indicação NÃO é mais creditada pelo cliente: ela acontece
      // no servidor (Admin SDK, via qualifyReferralForPaidOrder) somente após a 1ª
      // compra paga do indicado — por isso não há regra cliente que permita somar
      // pontos na conta de OUTRO usuário (fechando o vetor de abuso anterior).
      // Owner: não mexe em role/comissão/idade/aniversário (bônus do cron), só pode
      // DIMINUIR o próprio saldo de pontos (resgate) e grava referralCode/referredBy
      // apenas uma vez (backfill/cadastro).
      // Vendedor (PDV): credita/estorna pontos de um CLIENTE (só loyaltyPoints).
      allow update: if (isOwner(uid) && ownerProfileUpdateOk())
                    || isAdmin()
                    || (isSeller()
                        && resource.data.get('role', 'customer') == 'customer'
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['loyaltyPoints', 'updatedAt']));
      allow delete: if isAdmin();
    }

    // ── Products ──────────────────────────────────────────────
    // Public catalog — anyone can read products.
    // Admins/sellers manage full CRUD.
    // Authenticated customers can only decrement stock (loyalty redemption).
    // ── Categorias de produto (gerenciadas pelo admin) ──────────
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin() || isSeller();
    }

    // ── Áreas de entrega / frete por bairro (gerenciadas pelo admin) ──
    match /deliveryAreas/{areaId} {
      allow read: if true;
      allow write: if isAdmin() || isSeller();
    }

    // Custo e imposto dos produtos (uso interno) — fora do documento público.
    match /productCosts/{productId} {
      allow read, write: if isAdmin() || isSeller();
    }

    match /products/{productId} {
      allow read: if true;
      allow create, delete: if isAdmin() || isSeller();
      // Estoque do checkout/resgate/confirmação WhatsApp é baixado no servidor
      // (Admin SDK) — clientes não gravam mais em produtos.
      allow update: if isAdmin() || isSeller();
    }

    // Cliente só mantém o status financeiro ou o cancela (nunca "paid").
    function customerPaymentChangeOk() {
      let np = request.resource.data.get('payment', {});
      let op = resource.data.get('payment', {});
      let nps = request.resource.data.get('paymentStatus', null);
      return np.diff(op).affectedKeys().hasOnly(['status', 'history'])
        && (np.get('status', null) == op.get('status', null) || np.get('status', null) == 'cancelled')
        && (nps == resource.data.get('paymentStatus', null) || nps == 'cancelled');
    }

    // ── Orders ────────────────────────────────────────────────
    match /orders/{orderId} {
      allow read: if isAuth() && (
        resource.data.customerId == request.auth.uid ||
        isAdmin() ||
        isSeller() ||
        (isMotoboy() && resource.data.motoboyId == request.auth.uid) ||
        // Pool de auto-atendimento: motoboys leem entregas ainda sem dono — só
        // pedidos de entrega (retirada na loja não expõe o cliente ao motoboy).
        (isMotoboy() && resource.data.motoboyId == null
          && resource.data.deliveryAddress.id != 'pickup')
      );
      // Pedidos nascem só no servidor (/api/orders/create e /api/loyalty/redeem,
      // Admin SDK), que confere preços/frete/cupom/total e baixa o estoque na
      // mesma transação — o navegador não cria pedido direto.
      allow create: if false;
      // Mudança de STATUS (com estoque, cupom e pontos de resgate) é feita no
      // servidor (/api/orders/status, Admin SDK). O motoboy dono da entrega só
      // grava, pelo navegador, a localização/telefone da rota — antes podia
      // alterar qualquer campo do pedido (inclusive total/pricedBy).
      allow update: if isAdmin()
        || isSeller()
        || (isMotoboy() && resource.data.motoboyId == request.auth.uid
            && request.resource.data.motoboyId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['motoboyLocation', 'motoboyPhone', 'motoboyName', 'motoboyId', 'updatedAt']))
        // Motoboy "pega" uma entrega sem dono, atribuindo-a a si mesmo. Só pode
        // mexer em motoboyId/motoboyName/updatedAt e quando ainda não há dono.
        || (isMotoboy()
            && resource.data.motoboyId == null
            && request.resource.data.motoboyId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['motoboyId', 'motoboyName', 'updatedAt']))
        || (isAuth() && resource.data.customerId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['notes']))
        // Cliente respondendo "A compra foi efetuada?" (fluxo WhatsApp) com "não":
        // cancela o próprio pedido enquanto ainda aguarda confirmação (o "sim"
        // roda no servidor, que baixa o estoque). Restrito aos campos do fluxo,
        // para impedir escalonamento (ex.: marcar como entregue). O status financeiro
        // só pode ficar igual ou ir para "cancelled" — antes o cliente podia
        // marcar o próprio pedido como PAGO (e liberar o bônus de indicação).
        // Após cancelar, a 2ª escrita (updatePaymentStatus "cancelled") também
        // precisa passar, por isso aceita resource.status == 'cancelled'.
        // O app atual faz isso no servidor (/api/orders/decline-whatsapp, que
        // também libera o cupom); a regra fica por compatibilidade e aceita o
        // pedido ainda "reserved" (feito com a loja fechada).
        // Nenhum ramo de cliente/motoboy inclui `total`, `pricedBy`, itens ou
        // preços: esses campos só mudam pelo servidor ou pela equipe.
        || (isAuth() && resource.data.customerId == request.auth.uid
            && (resource.data.get('paymentMethod', '') == 'whatsapp'
                || resource.data.get('payment', {}).get('method', '') == 'whatsapp')
            && resource.data.get('awaitingConfirmation', false) == true
            && resource.data.status in ['reserved', 'received', 'cancelled']
            && request.resource.data.status == 'cancelled'
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['status', 'statusHistory', 'payment', 'paymentStatus', 'updatedAt'])
            && customerPaymentChangeOk());
      allow delete: if isAdmin();
    }

    // ── Sales ─────────────────────────────────────────────────
    match /sales/{saleId} {
      allow read:   if isAdmin() || isSeller();
      allow create: if isAdmin() || isSeller();
      // Vendedor registra venda e recebimentos (paid/partial/pending), mas NÃO pode
      // cancelar (paymentStatus = "cancelled") nem mexer numa venda já cancelada —
      // cancelamento/estorno é exclusivo do admin.
      allow update: if isAdmin()
        || (isSeller()
            && resource.data.paymentStatus != 'cancelled'
            && request.resource.data.paymentStatus != 'cancelled');
      allow delete: if isAdmin();
    }

    // ── Loyalty Transactions ──────────────────────────────────
    // Read: dono (a query filtra por userId) ou equipe — antes qualquer logado
    // listava o extrato de todos. Create: equipe (PDV/admin) ou o próprio cliente
    // apenas para o bônus de boas-vindas (<= 50) e débitos de resgate (<= 0).
    match /loyaltyTransactions/{txId} {
      allow read: if isAuth() && (resource.data.userId == request.auth.uid || isSeller());
      allow create: if isSeller()
                    || (isAuth()
                        && request.resource.data.userId == request.auth.uid
                        && request.resource.data.points is number
                        // Resgates ("redeemed") agora são lançados só pelo servidor
                        // (/api/loyalty/redeem, Admin SDK); o cliente só grava o bônus de boas-vindas.
                        && request.resource.data.type == 'welcome'
                        && request.resource.data.points <= 50);
      allow update, delete: if isAdmin();
    }

    // ── Referral Codes ────────────────────────────────────────
    // Public lookup (code → uid) so a new user can resolve who referred them
    // without reading the private users collection. The mapping holds no PII.
    // Each user creates only their own mapping (uid must match); admins may seed.
    match /referralCodes/{code} {
      allow read: if isAuth();
      // Update só pelo próprio dono do código: antes qualquer logado podia
      // sobrescrever o código de OUTRO usuário apontando-o para si (sequestro).
      allow create: if isAdmin()
                    || (isAuth() && request.resource.data.uid == request.auth.uid);
      allow update: if isAdmin()
                    || (isAuth() && resource.data.uid == request.auth.uid
                        && request.resource.data.uid == request.auth.uid);
      allow delete: if isAdmin();
    }

    // ── Referrals (vínculo indicador↔indicado) ────────────────
    // Doc id = uid do indicado. Criado pelo próprio indicado no cadastro, sempre
    // como "pending" e sem pontos — a bonificação ao indicador só é liberada na
    // 1ª compra paga (Task 3.2), por caminho confiável (servidor/admin).
    // Leitura: o indicado, o indicador ou um admin.
    match /referrals/{referredUserId} {
      allow read: if isAuth() && (
        referredUserId == request.auth.uid ||
        resource.data.referrerId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isAuth()
                    && referredUserId == request.auth.uid
                    && request.resource.data.referredUserId == request.auth.uid
                    && request.resource.data.referrerId != request.auth.uid
                    && request.resource.data.status == 'pending'
                    && request.resource.data.pointsAwarded == 0;
      // A promoção para "qualified" + crédito de pontos é feita pelo admin/servidor.
      allow update, delete: if isAdmin();
    }

    // ── Cupons de desconto (Task 3.3) ─────────────────────────
    // Leitura por usuários logados (validação do código no checkout).
    // Gerenciamento (criar/editar/excluir) restrito a admin/vendedor.
    match /coupons/{code} {
      allow read: if isAuth();
      allow write: if isAdmin() || isSeller();
    }

    // Registros de uso do cupom: o cliente cria o próprio uso ao fechar o pedido;
    // leitura liberada a logados (contagem por CPF no checkout). Edição/remoção admin.
    match /couponRedemptions/{id} {
      // Guarda CPF: cada cliente lê só os próprios resgates; a contagem por CPF
      // (limite do cupom) é feita no servidor em /api/coupons/usage.
      allow read: if isSeller()
                  || (isAuth() && resource.data.userId == request.auth.uid);
      // Vendedor/admin registram o uso feito no PDV; no checkout online o uso é
      // gravado pelo servidor na mesma transação do pedido. Ao cancelar o pedido,
      // o servidor (Admin SDK) apaga o uso — por isso o delete segue só admin.
      allow create: if isSeller();
      allow update, delete: if isAdmin();
    }

    // ── Marketing / CRM ───────────────────────────────────────
    // Leitura e escrita de TODAS as coleções de marketing: exclusivas do admin
    // (o vendedor não acessa esta área). O único acesso de cliente é a própria
    // sessão de carrinho abandonado, que ele mesmo cria/atualiza no heartbeat.
    match /marketingCampaigns/{id}  { allow read, write: if isAdmin(); }
    match /marketingSegments/{id}   { allow read, write: if isAdmin(); }
    match /marketingAutomations/{id}{ allow read, write: if isAdmin(); }
    match /marketingTemplates/{id}  { allow read, write: if isAdmin(); }
    match /marketingExecutions/{id} { allow read, write: if isAdmin(); }
    match /marketingEvents/{id}     { allow read, write: if isAdmin(); }
    match /marketingSettings/{id}   { allow read, write: if isAdmin(); }

    // Sessão de carrinho (doc id = uid): o cliente grava apenas a própria, e só
    // com userId igual ao próprio uid. A leitura das sessões (público de carrinho
    // abandonado) é admin; o dono também pode ler a própria.
    match /marketingCartSessions/{uid} {
      allow read: if isAdmin() || isOwner(uid);
      allow create, update: if isAuth()
                            && request.auth.uid == uid
                            && request.resource.data.userId == request.auth.uid;
      allow delete: if isAdmin() || isOwner(uid);
    }

    // ── Lounge Bookings ───────────────────────────────────────
    // Criação pública (formulário sem login), mas valida os campos obrigatórios
    // e força status "pending" para impedir reservas-lixo ou já "aprovadas".
    match /lounge_bookings/{bookingId} {
      allow create: if request.resource.data.status == 'pending'
                    && request.resource.data.name is string && request.resource.data.name.size() > 0
                    && request.resource.data.whatsapp is string && request.resource.data.whatsapp.size() > 0
                    && request.resource.data.date is string
                    && request.resource.data.time is string;
      allow read, update, delete: if isAdmin();
    }

    // ── Lounge Slots (trava pública de horário, sem PII) ──────
    // Guarda apenas { date, time } para impedir conflito de horário. Leitura
    // pública permite ao formulário desabilitar horários ocupados. Qualquer um
    // pode CRIAR um slot livre (a transação garante unicidade), mas só o admin
    // pode sobrescrever/remover — o que impede roubar/alterar um slot existente.
    // A criação só aceita exatamente { date, time, createdAt } (sem lixo extra).
    match /lounge_slots/{slotId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['date', 'time', 'createdAt'])
                    && request.resource.data.date is string
                    && request.resource.data.time is string;
      allow update, delete: if isAdmin();
    }

    // ── Banners / CMS ─────────────────────────────────────────
    match /banners/{bannerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /events/{eventId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Site Settings ─────────────────────────────────────────
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Stock Movements ───────────────────────────────────────
    match /stockMovements/{movId} {
      allow read, write: if isAdmin() || isSeller();
    }

    // ── Reviews (avaliações de pedidos) ───────────────────────
    // List: autenticados (o app filtra por customerId). Get: dono ou admin.
    // Create: o próprio cliente. Update/delete: só admin.
    match /reviews/{id} {
      allow read:   if isAuth() && (resource.data.customerId == request.auth.uid || isSeller());
      allow create: if isAuth() && request.resource.data.customerId == request.auth.uid
                    && request.resource.data.rating is int
                    && request.resource.data.rating >= 1 && request.resource.data.rating <= 5;
      allow update, delete: if isAdmin();
    }

    // ── Commissions ───────────────────────────────────────────
    match /commissions/{commId} {
      allow read: if isAdmin() || (isAuth() && resource.data.sellerId == request.auth.uid);
      allow write: if isAdmin();
    }

    // ── Reports (problemas reportados por usuários) ───────────
    // Qualquer um pode criar um reporte (inclusive visitante não logado), desde
    // que tenha uma mensagem válida e status "open". Só o admin lê/resolve/exclui.
    match /reports/{reportId} {
      allow create: if request.resource.data.status == 'open'
                    && request.resource.data.message is string
                    && request.resource.data.message.size() > 0
                    && request.resource.data.message.size() <= 2000
                    && request.resource.data.page is string;
      allow read, update, delete: if isAdmin();
    }

    // ── Observabilidade / Centro de Operações (admin) ────────
    // Erros de sistema, logs de webhook, execuções de cron, alertas e métricas
    // diárias. A CRIAÇÃO é exclusiva do servidor (Admin SDK, bypassa as regras);
    // o cliente nunca cria nada aqui. O admin pode ler tudo e resolver alertas/
    // erros apenas nos campos de resolução (o resto é imutável do servidor).
    match /systemErrors/{errorId} {
      allow read: if isAdmin();
      allow update: if isAdmin()
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['resolved', 'resolvedAt', 'resolvedBy']);
      allow delete: if isAdmin();
    }

    match /webhookLogs/{logId} {
      allow read: if isAdmin();
    }

    match /cronExecutions/{execId} {
      allow read: if isAdmin();
    }

    match /systemAlerts/{alertId} {
      allow read: if isAdmin();
      allow update: if isAdmin()
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['status', 'resolvedAt', 'resolvedBy']);
    }

    match /systemMetrics/{day} {
      allow read: if isAdmin();
    }

    // ── Notificações in-app (por usuário) ─────────────────────
    // O dono lê as suas e pode marcá-las como lida (apenas o campo `read`).
    // A equipe (admin/vendedor/motoboy) cria notificações — ex.: atualização
    // de status de pedido para o cliente. Ninguém forja para si mesmo.
    match /notifications/{notifId} {
      allow read:   if isAdmin() || isOwner(resource.data.userId);
      allow create: if isAdmin() || isSeller() || isMotoboy();
      allow update: if isAdmin()
                    || (isOwner(resource.data.userId)
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']));
      allow delete: if isAdmin() || isOwner(resource.data.userId);
    }

    // ── Avisos / Promoções (globais, geridos pelo admin) ──────
    // Qualquer um lê (a leitura por usuário é marcada localmente no cliente).
    match /announcements/{id} {
      allow read:  if true;
      allow write: if isAdmin() || isSeller();
    }
  }
}
